<Window x:Class="EngineeringQuantityAuditComparer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EngineeringQuantityAuditComparer.App"
        xmlns:core="clr-namespace:EngineeringQuantityAuditComparer.Core;assembly=EngineeringQuantityAuditComparer.Core"
        Title="工程量审减分析助手"
        Width="1280" Height="820" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" AllowDrop="True">
    <Window.Resources>
        <app:DifferenceToBrushConverter x:Key="DifferenceToBrushConverter" />
        <Style x:Key="InitialDifferenceCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding InitialVsSubmissionDifference, Converter={StaticResource DifferenceToBrushConverter}}" />
        </Style>
        <Style x:Key="FinalDifferenceCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding FinalVsSubmissionDifference, Converter={StaticResource DifferenceToBrushConverter}}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="工程量审减分析助手" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="送审清单与初审／终审清单自动匹配 · 全程离线 · 原始文件不改动" Foreground="#DCEDEB" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#3F8580" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock Text="开源版  v1.0" Foreground="White" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource PrimaryBrush}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <TextBlock Text="选择文件" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <Rectangle Grid.Column="1" Height="2" Fill="#BCD2CF" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#7DA9A5"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <TextBlock Text="匹配复核" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <Rectangle Grid.Column="3" Height="2" Fill="#BCD2CF" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#7DA9A5"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                    <TextBlock Text="预览与导出" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="28,22">
            <Grid Visibility="{Binding IsFileStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="选择工程量清单" FontSize="22" FontWeight="SemiBold" Foreground="#213B39" />
                    <TextBlock Text="送审必选，初审和终审至少选择一份。支持 .xls 和 .xlsx，也可将文件直接拖到对应区域。" Foreground="#657B79" Margin="0,7,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,22,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="#8EB6B2" BorderThickness="2" CornerRadius="10" Padding="28" AllowDrop="True" Tag="Submission" DragOver="FileDrop_DragOver" Drop="FileDrop_Drop">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#E2F0D9" HorizontalAlignment="Center"><TextBlock Text="送" FontSize="24" Foreground="#2F7570" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="送审工程量清单" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Text="A 列序号将以此文件的原始序号为准" Foreground="#667D7A" HorizontalAlignment="Center" />
                            <TextBox Text="{Binding SubmissionPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,24,0,12" Height="38" Padding="10,7" BorderBrush="#C9DAD8" IsReadOnly="True" />
                            <Button Content="选择送审文件" HorizontalAlignment="Center" Click="BrowseSubmission_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="#D8BF68" BorderThickness="2" CornerRadius="10" Padding="24" AllowDrop="True" Tag="InitialReview" DragOver="FileDrop_DragOver" Drop="FileDrop_Drop">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#FFF2CC" HorizontalAlignment="Center"><TextBlock Text="审" FontSize="24" Foreground="#8A6B13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="审计初审工程量清单" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Text="初审归零或缺失项会写入真正的数值 0" Foreground="#667D7A" HorizontalAlignment="Center" />
                            <TextBox Text="{Binding InitialReviewPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,24,0,12" Height="38" Padding="10,7" BorderBrush="#C9DAD8" IsReadOnly="True" />
                            <Button Content="选择初审文件" HorizontalAlignment="Center" Click="BrowseInitialReview_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="White" BorderBrush="#B6A7C8" BorderThickness="2" CornerRadius="10" Padding="24" AllowDrop="True" Tag="FinalReview" DragOver="FileDrop_DragOver" Drop="FileDrop_Drop">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="29" Background="#EDE7F6" HorizontalAlignment="Center"><TextBlock Text="终" FontSize="24" Foreground="#65507A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="审计终审工程量清单" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Text="终审结果可单独与送审稿进行对比" Foreground="#667D7A" HorizontalAlignment="Center" />
                            <TextBox Text="{Binding FinalReviewPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,24,0,12" Height="38" Padding="10,7" BorderBrush="#C9DAD8" IsReadOnly="True" />
                            <Button Content="选择终审文件" HorizontalAlignment="Center" Click="BrowseFinalReview_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <Expander Header="匹配容差设置" HorizontalAlignment="Left" Foreground="#385D59">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="金额容差（元）" VerticalAlignment="Center" />
                            <TextBox Text="{Binding AmountTolerance, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="8,0,20,0" Padding="6,3" />
                            <TextBlock Text="工程量容差" VerticalAlignment="Center" />
                            <TextBox Text="{Binding QuantityTolerance, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="8,0,0,0" Padding="6,3" />
                        </StackPanel>
                    </Expander>
                    <Button Content="开始自动分析" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Right" MinWidth="170" />
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsExceptionStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="确认单位工程匹配" FontSize="22" FontWeight="SemiBold" Foreground="#213B39" />
                    <TextBlock Text="全部单位工程均在下表展示。清单项目仅在名称、项目特征描述和计量单位一致时自动匹配；不一致项直接按新增处理。"
                               Foreground="#657B79" Margin="0,7,0,0" />
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,18,0,8" VerticalAlignment="Top">
                    <TextBlock Text="单位工程匹配（显示全部）" FontSize="16" FontWeight="SemiBold" Foreground="#385D59" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <StackPanel x:Name="InitialMoveButtons" Orientation="Horizontal">
                            <Button Content="初审上移" Command="{Binding MoveInitialUpCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="初审下移" Command="{Binding MoveInitialDownCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                        </StackPanel>
                        <StackPanel x:Name="FinalMoveButtons" Orientation="Horizontal">
                            <Button Content="终审上移" Command="{Binding MoveFinalUpCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="终审下移" Command="{Binding MoveFinalDownCommand}" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1"
                          Margin="0,58,0,12"
                          ItemsSource="{Binding UnitMatchRows}"
                          SelectedItem="{Binding SelectedUnitMatchRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          MinHeight="160">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                    <Setter Property="Background" Value="#FFFFE3E3" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RequiresConfirmation}" Value="True" />
                                        <Condition Binding="{Binding IsConfirmed}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#FFE7F4EF" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="人工确认" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding RequiresConfirmation}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="送审单位工程" Binding="{Binding Submission.Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="UnitMatchInitialColumn" Header="初审单位工程" Binding="{Binding InitialReview.Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="UnitMatchFinalColumn" Header="终审单位工程" Binding="{Binding FinalReview.Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="异常原因" Binding="{Binding Reason}" Width="280" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2">
                    <Button Content="返回重新选文件" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BackToFiles_Click" />
                    <Button Content="确认单位工程并进入预览" Command="{Binding ConfirmAllCommand}" HorizontalAlignment="Right" MinWidth="230" />
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsPreviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="170" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="分析预览与导出" FontSize="22" FontWeight="SemiBold" Foreground="#213B39" />
                    <TextBlock Text="单位工程页为不含税清单金额；导出会生成对比工作簿及独立的审减分析报告。对比工作簿前三页为两张看板和汇总表，可在下表补充专业原因。" Foreground="#657B79" Margin="0,7,0,0" />
                </StackPanel>
                <DataGrid Grid.Row="1" Margin="0,16,0,14" ItemsSource="{Binding UnitPreviews}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单位工程" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="送审不含税金额" Binding="{Binding SubmissionAmount, StringFormat=N2}" Width="150" />
                        <DataGridTextColumn x:Name="UnitInitialAmountColumn" Header="初审不含税金额" Binding="{Binding InitialAmount, StringFormat=N2}" Width="150" />
                        <DataGridTextColumn x:Name="UnitFinalAmountColumn" Header="终审不含税金额" Binding="{Binding FinalAmount, StringFormat=N2}" Width="150" />
                        <DataGridTextColumn x:Name="UnitInitialVsSubmissionColumn" Header="差异（送审-初审）" Binding="{Binding InitialVsSubmissionDifference, StringFormat=N2}" CellStyle="{StaticResource InitialDifferenceCellStyle}" Width="160" />
                        <DataGridTextColumn x:Name="UnitFinalVsSubmissionColumn" Header="差异（送审-终审）" Binding="{Binding FinalVsSubmissionDifference, StringFormat=N2}" CellStyle="{StaticResource FinalDifferenceCellStyle}" Width="160" />
                        <DataGridTextColumn Header="异常数" Binding="{Binding ExceptionCount}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding DifferencePreviews}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单位工程" Binding="{Binding UnitProjectName}" Width="180" IsReadOnly="True" />
                        <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="项目编码" Binding="{Binding Code}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="项目名称" Binding="{Binding Name}" Width="180" IsReadOnly="True" />
                        <DataGridTextColumn Header="送审合价" Binding="{Binding SubmissionTotal, StringFormat=N2}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ItemInitialTotalColumn" Header="初审合价" Binding="{Binding InitialTotal, StringFormat=N2}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ItemFinalTotalColumn" Header="终审合价" Binding="{Binding FinalTotal, StringFormat=N2}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ItemInitialVsSubmissionColumn" Header="送审-初审" Binding="{Binding InitialVsSubmissionDifference, StringFormat=N2}" CellStyle="{StaticResource InitialDifferenceCellStyle}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ItemFinalVsSubmissionColumn" Header="送审-终审" Binding="{Binding FinalVsSubmissionDifference, StringFormat=N2}" CellStyle="{StaticResource FinalDifferenceCellStyle}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="自动批注及专业原因" Binding="{Binding CombinedComment}" Width="210" IsReadOnly="True" />
                        <DataGridTextColumn Header="补充专业原因（可编辑）" Binding="{Binding UserComment, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Button Content="返回重新选文件" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BackToFiles_Click" />
                    <Button Content="导出对比表及分析报告" HorizontalAlignment="Right" MinWidth="210" Click="Export_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#385D59" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="150" Height="8" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="12,5" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
